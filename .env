# ============================================
# Track Data Platform - Environment Variables
# ============================================

# Oracle Database (Fonte de Dados)
# Hostname: etbdb002
# Quando túnel SSH estiver ativo, use localhost. Caso contrário, use o IP direto.
ORACLE_HOST=localhost
ORACLE_PORT=11522
ORACLE_SERVICE=bi.grupotracker.com.br
ORACLE_USER=clickhouse
ORACLE_PASSWORD=qiU!EOoe
ORACLE_TUNNEL_HOST=10.255.150.11

# SSH Tunnel Configuration (para acesso ao Oracle)
SSH_GATEWAY=10.255.150.11
SSH_USER=amaro.neto.beanalytic
SSH_KEY=/home/amaro-neto/.ssh/key_pop
LOCAL_PORT=11522


# ClickHouse Cloud (Destino - Analytics)
CLICKHOUSE_HOST=e1a1lieug8.us-central1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=_uv765EvWphL_
#CLICKHOUSE_DATABASE=siga
#CLICKHOUSE_SECURE=true

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=8g
SPARK_EXECUTOR_CORES=4
SPARK_SQL_SHUFFLE_PARTITIONS=200
SPARK_SQL_ADAPTIVE_ENABLED=true

# Pipeline Settings
REF_DATE_FORMAT=%Y-%m-%d
BATCH_SIZE=100000
FETCH_SIZE=10000
NUM_PARTITIONS=10



# AWS S3 (Data Lake Storage)
S3_ENDPOINT=s3.amazonaws.com
S3_BUCKET=track-datalake-prod
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1

# Storage Configuration
USE_S3_STORAGE=true
AUTO_CLEANUP_TEMP=true
TEMP_RETENTION_HOURS=2

# Logging
LOG_LEVEL=INFO

# Metadata Service
METADATA_API_PORT=8000
METADATA_DB_PATH=platform/metadata

# Monitoring (Opcional)
MONITORING_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
EMAIL_ALERTS_TO=data-team@track.com
CLICKHOUSE_VERIFY=true
