# Oracle Database (Apenas Fonte)
ORACLE_HOST=your-oracle-host.com
ORACLE_PORT=1521
ORACLE_SERVICE=SERVICE_NAME
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password

# ClickHouse Cloud (Destino Principal)
CLICKHOUSE_HOST=your-clickhouse-cloud.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_SECURE=true

# S3/Object Storage (Para Parquets no ClickHouse Cloud)
S3_ENDPOINT=s3.amazonaws.com
S3_BUCKET=your-data-lake-bucket
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1

# Storage Strategy
USE_S3_STORAGE=true  # true = ClickHouse Cloud + S3, false = local
AUTO_CLEANUP_TEMP=true  # Limpa arquivos temporários automaticamente
TEMP_RETENTION_HOURS=2  # Mantém temp files por 2 horas

# Spark
SPARK_MASTER=local[*]

# Pipeline Configuration
BATCH_SIZE=100000
FETCH_SIZE=10000
NUM_PARTITIONS=10

# Logging
LOG_LEVEL=INFO
