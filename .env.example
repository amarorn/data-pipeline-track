# ============================================
# Track Data Platform - Environment Variables
# ============================================

# Oracle Database (Fonte de Dados)
ORACLE_HOST=your-oracle-host.com
ORACLE_PORT=1521
ORACLE_SERVICE=SERVICE_NAME
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password

# ClickHouse Cloud (Destino - Analytics)
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_DB=track_bronze
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_password
CLICKHOUSE_SECURE=true
ORACLE_HOST=10.0.0.137
ORACLE_PORT=1521
ORACLE_SERVICE=ORCLPDB1
ORACLE_USER=admin
ORACLE_PASSWORD=Admin#2025

CLICKHOUSE_HOST=your-clickhouse-cloud.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-password
CLICKHOUSE_DATABASE=data_lake
CLICKHOUSE_SECURE=true

SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=8g
SPARK_EXECUTOR_CORES=4
SPARK_SQL_SHUFFLE_PARTITIONS=200
SPARK_SQL_ADAPTIVE_ENABLED=true

REF_DATE_FORMAT=%Y-%m-%d
BATCH_SIZE=100000
# AWS S3 (Data Lake Storage)
S3_ENDPOINT=s3.amazonaws.com
S3_BUCKET=track-datalake-prod
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1

# Storage Configuration
USE_S3_STORAGE=true              # true = S3 + ClickHouse Cloud, false = local
AUTO_CLEANUP_TEMP=true           # Limpa /temp automaticamente
TEMP_RETENTION_HOURS=2           # Retenção de arquivos temporários

# Spark Configuration
SPARK_MASTER=local[*]            # local[*], yarn, k8s://...
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Pipeline Settings
BATCH_SIZE=100000
FETCH_SIZE=10000
NUM_PARTITIONS=10

# Logging
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR

# Metadata Service
METADATA_API_PORT=8000
METADATA_DB_PATH=platform/metadata

# Monitoring (Opcional)
MONITORING_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
EMAIL_ALERTS_TO=data-team@track.com
