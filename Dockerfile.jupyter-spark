FROM jupyter/pyspark-notebook:x86_64-python-3.11
FROM jupyter/pyspark-notebook:spark-3.4.1

USER root

# Instala dependências adicionais
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}

# Instala requirements Python
COPY requirements-jupyter.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-jupyter.txt

# Baixa JARs necessários
RUN cd $SPARK_HOME/jars && \
    wget -q https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    wget -q https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar && \
    wget -q https://repo1.maven.org/maven2/com/oracle/database/jdbc/ojdbc8/21.9.0.0/ojdbc8-21.9.0.0.jar && \
    wget -q https://repo1.maven.org/maven2/com/clickhouse/clickhouse-jdbc/0.4.6/clickhouse-jdbc-0.4.6-all.jar

# Diretório de trabalho
WORKDIR /app

# Copia código do projeto
COPY --chown=${NB_UID}:${NB_GID} layers/ /app/layers/
COPY --chown=${NB_UID}:${NB_GID} shared/ /app/shared/

# Configurações Jupyter
RUN mkdir -p /home/jovyan/.jupyter && \
    echo "c.NotebookApp.token = ''" >> /home/jovyan/.jupyter/jupyter_notebook_config.py && \
    echo "c.NotebookApp.password = ''" >> /home/jovyan/.jupyter/jupyter_notebook_config.py

EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
USER root

RUN pip install --no-cache-dir pandas sqlalchemy oracledb clickhouse-driver pyyaml python-dotenv

USER $NB_UID

WORKDIR /home/jovyan

ENV PYSPARK_PYTHON=python
ENV PYSPARK_DRIVER_PYTHON=jupyter

CMD ["start-notebook.sh", "--NotebookApp.token=", "--NotebookApp.password="]
